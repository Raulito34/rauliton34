# ══════════════════════════════════════════════════════
# Database (Railway가 자동 주입 — 로컬에서만 수동 설정)
# ══════════════════════════════════════════════════════
DATABASE_URL=postgresql://localhost:5432/artcenter

# ══════════════════════════════════════════════════════
# Admin authentication (Railway Variables에 반드시 설정)
# 없으면 기본값 admin1234 로 폴백 → 보안 위험
# ══════════════════════════════════════════════════════
ADMIN_CODE=

# ══════════════════════════════════════════════════════
# CORS — 허용할 프론트엔드 URL (쉼표로 구분)
# ══════════════════════════════════════════════════════
CLIENT_URL=https://rauliton34.vercel.app,http://localhost:3000

# ══════════════════════════════════════════════════════
# Notifications (선택사항 — 하나 이상 설정 시 새 대관 신청 알림 자동 발송)
# 자세한 설정 방법: INTEGRATION_NOTIFICATIONS.md 참조
# ══════════════════════════════════════════════════════

# Slack — https://api.slack.com/apps 에서 Incoming Webhook 생성
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# Kakao Work — 관리자 콘솔 > 빌더 > 커스텀 앱 > Incoming Webhook
# KAKAO_WEBHOOK_URL=https://...kakaowork.com/webhooks/...

# Discord — 서버 설정 > 통합 > 웹후크
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/.../...

# Generic (Zapier/Make/n8n 연동용)
# GENERIC_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/...

# 관리자 페이지 URL (알림 카드에 버튼으로 포함됨)
# ADMIN_URL=https://rauliton34.vercel.app/admin/rentals
